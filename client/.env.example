# Production API base URL (Render example: https://your-app.onrender.com/api)
VITE_API_URL=http://localhost:3000/api

# Production Socket.io URL (Render example: https://your-app.onrender.com)
VITE_SOCKET_URL=http://localhost:3000

# Stripe publishable key only — never use secret keys on the client
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
